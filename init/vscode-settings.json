{
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[markdown]": {
        "files.trimTrailingWhitespace": false
    },
    "[python]": {
        "editor.formatOnType": true
    },
    "[yaml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "aws.cloudformation.telemetry.enabled": false,
    "aws.telemetry": false,
    "base16.generator.activatedThemes": ["base16-tomorrow-light", "base16-tomorrow-night-dark"],
    "chat.disableAIFeatures": true,
    "claudeCode.preferredLocation": "panel",
    "datadog.telemetry.setup.enableTelemetry": "disabled",
    "datadog.timeRange.setup.timeFrame": "2d",
    "docker.extension.enableComposeLanguageServer": false,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "always",
        "source.fixAll.ts": "always"
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.fontFamily": "'FiraCode Nerd Font', 'Fira Code', Menlo, Monaco, 'Courier New', monospace",
    "editor.fontLigatures": true,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.guides.bracketPairs": "active",
    "editor.pasteAs.enabled": false,
    "editor.renderWhitespace": "selection",
    "editor.rulers": [120],
    "editor.scrollBeyondLastLine": false,
    "editor.showUnused": true,
    "editor.suggestSelection": "first",
    "editor.tabSize": 4,
    "editor.unicodeHighlight.includeStrings": false,
    "eslint.quiet": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "files.associations": {
        ".huskyrc": "jsonc",
        ".lintstagedrc": "jsonc",
        "tslint.json": "jsonc"
    },
    "files.exclude": {
        "**/.classpath": true,
        "**/.DS_Store": true,
        "**/.factorypath": true,
        "**/.git": true,
        "**/.hg": true,
        "**/.project": true,
        "**/.settings": true,
        "**/.svn": true,
        "**/bower_components": true,
        "**/CVS": true,
        "**/node_modules": true
    },
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "git.mergeEditor": false,
    "git.openRepositoryInParentFolders": "never",
    "gitlens.codeLens.authors.enabled": false,
    "gitlens.codeLens.recentChange.enabled": false,
    "gitlens.codeLens.scopes": ["document", "containers", "blocks"],
    "gitlens.liveshare.enabled": false,
    "html.format.enable": false,
    "jest.runMode": "deferred",
    "js/ts.format.enabled": false,
    "js/ts.preferences.importModuleSpecifier": "non-relative",
    "js/ts.preferences.preferTypeOnlyAutoImports": true,
    "js/ts.tsdk.path": "~/.local/share/mise/installs/node/lts-iron/lib/node_modules/typescript/lib",
    "js/ts.updateImportsOnFileMove.enabled": "never",
    "json.format.enable": false,
    "liveshare.launcherClient": "visualStudioCode",
    "makefile.configureOnOpen": false,
    "oxc.typeAware": true,
    "plantuml.server": "https://www.plantuml.com/plantuml",
    "react-native-tools.showUserTips": false,
    "redhat.telemetry.enabled": false,
    "search.globalFindClipboard": true,
    "security.promptForLocalFileProtocolHandling": false,
    "vsicons.associations.files": [
        {
            "icon": "layout",
            "extensions": ["layout.tsx", "_layout.tsx"],
            "filename": true
        },
        {
            "icon": "registry",
            "extensions": ["vm.ts", "vm.tsx"]
        }
    ],
    "vsicons.associations.folders": [
        {
            "icon": "component",
            "extensions": ["_components"]
        },
        {
            "icon": "api",
            "extensions": ["fetcher", "fetchers", "_fetcher", "_fetchers"]
        }
    ],
    "vsicons.dontShowNewVersionMessage": true,
    "window.autoDetectColorScheme": true,
    "window.newWindowDimensions": "inherit",
    "window.restoreWindows": "all",
    "window.zoomLevel": 0,
    "workbench.colorCustomizations": {
        "[Base16 Tomorrow Night Dark]": {
            "editorIndentGuide.background1": "#282a2e",
            "editorIndentGuide.activeBackground1": "#373b41",
            "editorBracketHighlight.foreground1": "#e7c547",
            "editorBracketHighlight.foreground2": "#c397d8",
            "editorBracketHighlight.foreground3": "#7aa6da",
            "editorBracketHighlight.foreground4": "#e78c45",
            "editorBracketHighlight.foreground5": "#b9ca4a",
            "editorBracketHighlight.foreground6": "#70c0b1",
            "editorBracketMatch.background": "#000000",
            "editorBracketHighlight.unexpectedBracket.foreground": "#d54e53"
        }
    },
    "workbench.colorTheme": "Base16 Tomorrow Night Dark",
    "workbench.iconTheme": "vscode-icons",
    "workbench.preferredDarkColorTheme": "Base16 Tomorrow Night Dark",
    "workbench.preferredLightColorTheme": "Base16 Tomorrow Light",
    "workbench.tips.enabled": false,
    "yaml.customTags": [
        "!And",
        "!And sequence",
        "!If",
        "!If sequence",
        "!Not",
        "!Not sequence",
        "!Equals",
        "!Equals sequence",
        "!Or",
        "!Or sequence",
        "!FindInMap",
        "!FindInMap sequence",
        "!Base64",
        "!Join",
        "!Join sequence",
        "!Cidr",
        "!Ref",
        "!Sub",
        "!Sub sequence",
        "!GetAtt",
        "!GetAZs",
        "!ImportValue",
        "!ImportValue sequence",
        "!Select",
        "!Select sequence",
        "!Split",
        "!Split sequence"
    ],
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ],
    "totalTypeScript.hiddenTips": [
        "typing-function-parameters",
        "function-return-type",
        "basic-types",
        "union-type",
        "array-type",
        "undefined-keyword",
        "ts-object-type"
    ]
}
